# Copia a infra/.env.local y completa con los valores de tu cuenta.
AWS_PROFILE=default
EXPECTED_AWS_ACCOUNT=123456789012
COHERE_KEY_PARAM=/postula/prod/COHERE_API_KEY      # parámetro SecureString de SSM con la clave de Cohere
ORIGINS='["https://tu-dominio.com","http://localhost:5173"]'
AUTH_API=https://auth.potenci.ai                    # servicio SIWE que emite y valida los tokens
